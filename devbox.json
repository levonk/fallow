{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.12.0/.schema/devbox.schema.json",
  "packages": [
    "rustc",
    "cargo",
    "rust-analyzer",
    "pkg-config"
  ],
  "shell": {
    "init_hook": [
      "echo 'Welcome to the Fallow dev environment!'"
    ],
    "scripts": {
      "build": "cargo build --release",
      "test": "cargo test",
      "run": "cargo run --release --",
      "lint": "cargo clippy",
      "fmt": "cargo fmt"
    }
  }
}
